---
import { supabaseFor } from '../../lib/supabase';
import Layout from '../../components/Layout.astro';
import DbError from '../../components/DbError.astro';
import Pagination from '../../components/Pagination.astro';
import AppList from '../../components/AppList.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { clampPage } from '../../lib/search';
import { APP_LIST_COLS, flattenAppRow } from '../../lib/apps';
import { cached } from '../../lib/cache';
import { setCacheHeaders, setDegraded } from '../../lib/http';
import { getAppIcons } from '../../lib/appicons';
import { devicesEndingOn } from '../../lib/emulator';
import { IOS_LANDING_MAJORS } from '../../lib/sitemap';

// "Apps for iOS N" landing pages — what owners of old devices search for. An
// app qualifies when its oldest-requirement archived version installs on N
// (apps.min_os_major ≤ N, derived by refresh_min_os_major()). Ranked by how many
// versions the archive holds. Capped at iOS 10: past that 32-bit apps stop
// running, so "min ≤ N" stops meaning "runs".
const MAJORS = IOS_LANDING_MAJORS;

const major = Number(Astro.params.major);
if (!MAJORS.includes(major)) return Astro.rewrite('/404');

setCacheHeaders(Astro.response, 86400); // archive data changes at ingest; deploys purge (purge-html.yml)

const PAGE_SIZE = 50;
const page = clampPage(new URL(Astro.request.url).searchParams.get('page'));
const supabase = supabaseFor(Astro);

const { data, error } = await cached<{ rows: any[]; total: number }>(`ios:${major}:${page}`, 10 * 60 * 1000, async () => {
  const { data, error, count } = await supabase
    .from('apps')
    .select(APP_LIST_COLS, { count: 'exact' })
    .lte('min_os_major', major)
    .not('excluded', 'is', true)
    .order('version_count', { ascending: false })
    .order('id', { ascending: true })
    .range((page - 1) * PAGE_SIZE, page * PAGE_SIZE - 1);
  return { data: { rows: (data || []).map(flattenAppRow), total: count || 0 }, error };
});
const apps = data?.rows || [];
const totalPages = Math.max(1, Math.ceil((data?.total || 0) / PAGE_SIZE));
const iconShas = apps.length ? await getAppIcons(supabase, apps.map((a: any) => Number(a.id))) : undefined;
if (error) setDegraded(Astro.response);

const devices = devicesEndingOn(major);
const fmt = (n: number) => n.toLocaleString('en-US');
const deviceText = devices.length
  ? devices.map((d) => `${d.name} (${d.maxOs})`).join(', ')
  : '';
---

<Layout
  title={`Apps for iOS ${major} — ${fmt(data?.total || 0)} Old iPhone & iPad Apps — Legacy Store`}
  activeTab="none"
  canonicalPath={`/ios/${major}${page > 1 ? `?page=${page}` : ''}`}
  description={`${fmt(data?.total || 0)} archived iPhone and iPad apps with a version that installs on iOS ${major}${devices.length ? `, for devices like the ${devices.slice(0, 3).map((d) => d.name).join(', ')}` : ''}.`}
>
  <div class="content">
    {error ? (
      <DbError />
    ) : (
      <>
        <SectionHeader title={`Apps for iOS ${major}`} level={1} detail={`${fmt(data?.total || 0)} apps with an archived version that installs on iOS ${major}`} />
        {deviceText && page === 1 && (
          <p class="ios-devices">Last update for: {deviceText}.</p>
        )}
        <p class="ios-nav">
          {MAJORS.map((m) => (m === major ? <strong>iOS {m}</strong> : <a href={`/ios/${m}`}>iOS {m}</a>))}
        </p>
        <AppList list={apps} startRank={(page - 1) * PAGE_SIZE + 1} iconShas={iconShas} />
        {totalPages > 1 && <Pagination page={page} totalPages={totalPages} hrefFor={(p) => `/ios/${major}?page=${p}`} nextLabel={`Next ${PAGE_SIZE}`} />}
      </>
    )}
  </div>
</Layout>

<style>
  .ios-devices { margin: 0 0 8px; font-size: 12px; color: #555; }
  .ios-nav { margin: 0 0 12px; font-size: 12px; }
  .ios-nav a, .ios-nav strong { margin-right: 8px; }
</style>
