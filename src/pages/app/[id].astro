        <div id="report-dialog" class="report-overlay">
          <div class="report-panel">
            <a class="report-x" href="#" aria-label="Close">&#215;</a>
            <h3 class="report-heading">Report an issue</h3>
            <p class="report-note">Noticed something wrong with <strong>{appTitle}</strong> or a download? Leave a note.</p>
            <form class="report-form" method="post" action="/api/report">
              <input type="hidden" name="app_store_id" value={appData.app_store_id ? String(appData.app_store_id) : ''} />
              <input type="hidden" name="app_id" value={String(appData.id)} />
              <input type="hidden" name="path" value={pathname} />
              {/* Honeypot — hidden off-screen; humans leave it empty, bots don't. */}
              <div class="report-hp" aria-hidden="true"><label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
              <textarea class="report-textarea" name="message" rows="5" maxlength="4000" placeholder="What's wrong, or what did you notice?" required></textarea>
              <div class="report-buttons">
                <a class="wsfbtn report-cancel" href="#">Cancel</a>
                <button type="submit" class="wsfbtn wsfbtn-primary">Submit</button>
              </div>
            </form>
          </div>
        </div>

        <div class="center-stack">
        {appDescription && (
          <div class="app-description">
            {appDescription.split(/\n{2,}/).filter((p: string) => p.trim()).map((para: string) => (
              <p>{para.trim()}</p>
            ))}
          </div>
        )}
        {screenshotSets.length > 0 && (
          <div class="screenshots" aria-label="Screenshots">
            <div class="shots-head">
              {screenshotSets.length > 1 ? (
                <label class="shots-pick-wrap">
