              {dlMenu.length > 0 && (
                <div class="dl-menu">
                  <button type="button" class="wsfbtn dl-btn" popovertarget="dl-list" aria-haspopup="true">Download<span class="tri"></span></button>
                  <ul class="dl-list" id="dl-list" popover>
                    {dlMenu.map((d) => (
                      <li><a href={d.href}>
                        <span class="dl-os">iOS {d.lo}{d.plus ? ' and later' : d.hi !== d.lo ? `–${d.hi}` : ''}</span>
                        <span class="dl-ver">Version {d.ver}</span>
