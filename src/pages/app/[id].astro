              )}
              {subgenre && <li class="genre"><span class="label">Subgenre</span>{subgenre}</li>}
              {appData.original_release_date && (
                <li title="When the app first appeared on the App Store (may predate our earliest archived copy)">
                  <span class="label">First released</span>{formatDate(appData.original_release_date)}</li>
              )}
              <li><span class="label">Versions</span>{versions.length} archived</li>
              {installableVersionCount > 0 && (
                <li><span class="label">Installable</span>{installableVersionCount} of {versions.length}</li>
              )}
              {appData.is_available === false && (
                <li class="availability"><span class="label">Availability</span>Removed from the App Store</li>
              )}
              {appData.is_available === true && appData.app_store_id && Number(appData.app_store_id) !== 0 && (
                <li class="availability"><span class="label">Availability</span><a href={`https://apps.apple.com/app/id${appData.app_store_id}`} rel="noopener">Still on the App Store</a></li>
              )}
              {developerName && <li class="seller"><span class="label">Seller</span>{developerName}</li>}
              <li class="copyright" title={appData.bundle_id}><span class="label phone-only">Bundle ID</span>{appData.bundle_id}</li>
            </ul>
            <p class="requirements"><span class="app-requirements">Requirements</span>{requirementsText}</p>
          </div>

          {lockupStars && (
            <div class="extra-list customer-ratings">
              <h4>Customer Ratings</h4>
              {latestRating?.captured_at && <div class="ratings-asof">As of {formatDate(latestRating.captured_at)}</div>}
              <div class="rating" role="text" aria-label={lockupStarsLabel}>
                <div>
                  {lockupStars.map((cls) => <span class={cls}>&nbsp;</span>)}
                </div>
                {latestRating.rating_count != null && (
                  <span class="rating-count">{formatNumber(latestRating.rating_count)} Ratings</span>
                )}
              </div>
            </div>
          )}

          {inCollections.length > 0 && (
            <div class="extra-list in-collections">
              <h4>In Collections</h4>
              <ul>
                {inCollections.map((c) => (
                  <li><a href={`/collections/${c.slug}`}>{c.title}</a></li>
                ))}
              </ul>
            </div>
          )}

          {/* Report an issue: a plain-form submission that works with no JS on
              old WebKit. The dialog is opened purely with :target (no script),
              so iOS 4–6 can use it. */}
          <div class="extra-list report-box">
            <h4>Something off?</h4>
            {reportOutcome === '1' ? (
              <p class="report-msg report-ok">Thanks — noted.</p>
            ) : (
              <>
                {reportOutcome === '0' && <p class="report-msg report-bad">That didn't save. Give it another go?</p>}
                <a class="report-open" href="#report-dialog">Report an issue</a>
              </>
            )}
          </div>
        </div>

        {/* Modal is position:fixed, so its spot in the DOM doesn't affect layout;
