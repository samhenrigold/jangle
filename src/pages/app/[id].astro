        <div class="jb-notice ota-yes">To install apps directly onto this device, it must be jailbroken with AppSync installed.</div>

        <div id="versions" class={showEverything ? 'versions show-everything' : 'versions'} data-order={currentDir}>
          {versionRows.map((row: any) => (
            <div class={row.hideByDefault ? 'version v-hidden-default' : 'version'} id={`v${row.v.id}`} data-minos={row.minosMajor != null && row.minosMajor > 0 ? String(row.minosMajor) : undefined} data-minos-full={row.minosFull || undefined} data-ipad-only={row.ipadOnly ? '1' : undefined} data-copies={row.extras.length > 0 ? String(row.extras.length + 1) : undefined}>
