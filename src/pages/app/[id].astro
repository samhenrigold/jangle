    }
    /* …anchored under the button where CSS anchor positioning exists. */
    @supports (anchor-name: --a) {
      .dl-btn { anchor-name: --dl-btn; }
      .dl-list { position-anchor: --dl-btn; inset: auto; top: anchor(bottom); left: anchor(left); margin: 4px 0 0; }
    }
    #main #content .dl-list a { display: block; padding: 5px 12px; overflow: hidden; color: #333; font-size: 12px; white-space: nowrap; }
    #main #content .dl-list a:hover { background: #298cda; color: #fff; text-decoration: none; }
    .dl-list .dl-os { font-weight: bold; }
    .dl-list .dl-ver { float: right; margin-left: 18px; color: #898989; }
    .dl-list a:hover .dl-ver { color: #d8eafd; }
    .dl-list .dl-all { margin-top: 4px; padding-top: 4px; border-top: 1px solid #e3e3e3; }
    #main #content .dl-list .dl-all a { color: #298cda; }
    #main #content #title a.hero-others { font-weight: bold; }

    @media screen and (max-width: 767px) {
      /* Icon moved beside the title by the script (iOS 6 header lockup). */
      #content #title.has-art { padding-left: 86px; min-height: 76px; }
      #main #content #title .title-art { position: absolute; left: 0; top: 2px; margin: 0; }
      #main #content #title .title-art div.artwork { width: 74px; height: 74px; background: transparent url('/icon-placeholder.png') 0 0 no-repeat; background-size: 74px 74px; }
      #main #content #title div.lockup.application div.artwork > img.artwork { width: 74px; height: 74px; }
      #main #content #title div.lockup.application div.artwork > span.mask { width: 76px; height: 77px; background-size: 76px 77px; }
      #main #content #title.has-art h1 { font-size: 18px; line-height: 22px; }
      #main #content #title.has-art h2 { font-size: 13px; line-height: 17px; }
      #content #title.has-art .view-more { display: none; }
      #content #title.has-art .hero-install.is-ready { padding-top: 6px; }
      /* The lockup list sits under the header now that the art moved out. */
      #content #title.has-art ~ #left-stack .lockup ul.list { overflow: visible; }
      #main #content .center-stack .screenshots { margin-bottom: 14px; }
      #content #title.has-art .hero-meta { display: block; margin: 5px 0 0; }
      #main #content #title.has-art { margin-bottom: 12px; }
      #content #title.has-art ~ #left-stack { margin-bottom: 0; }
      /* Info table moved under the description (iOS 6 "Information"). */
      .phone-info { margin: 0 0 18px; padding-top: 10px; border-top: 1px solid #e3e3e3; }
      #main #content .phone-info h4 { margin: 0 0 6px; font-size: 13px; color: #474747; }
      /* Label | value rows (iOS 6 "Information"). Each li is a table row; its
         unwrapped value text becomes an anonymous cell. */
      .phone-info ul.list, .phone-info p.requirements { display: table; width: 100%; margin: 0; padding: 0; list-style: none; table-layout: fixed; }
      .phone-info ul.list li { display: table-row; }
      .phone-info .label, .phone-info .app-requirements { display: table-cell; width: 96px; padding: 4px 8px 4px 0; color: #898989; font-weight: normal; vertical-align: baseline; }
      .phone-info ul.list li, .phone-info p.requirements { line-height: 17px; color: #474747; }
      .phone-info ul.list li .price { display: table-cell; padding: 4px 0; font-weight: normal; }
      .phone-info ul.list li.seller, .phone-info .fat-binary-blurb { display: none; }
      #main #content .phone-info ul.list li.copyright { width: auto; color: #474747; word-wrap: break-word; white-space: normal; }
      #main #content .phone-info p { margin: 0; color: #474747; }
    }

    /* Long descriptions collapse to 5 lines behind an iOS 6-style "More ▾"
       (added by the script below — without JS the full text shows). Global:
       the link is created at runtime, so it has no scoped-style attribute. */
    .app-description.is-clamped {
      max-height: 7.5em;
      overflow: hidden;
      position: relative;
      margin-bottom: 0;
    }
    .app-description.is-clamped:after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 1.5em;
      background: -webkit-gradient(linear, left top, left bottom, from(rgba(255, 255, 255, 0)), to(#fff));
      background: linear-gradient(rgba(255, 255, 255, 0), #fff);
    }
    #main #content .center-stack a.desc-more {
      display: block;
      margin: 2px 0 18px;
      padding: 4px 0;
      text-align: right;
      font-size: 13px;
      font-weight: bold;
      text-decoration: none;
    }
  </style>

  <script is:inline>
    (function () {
      if (!document.querySelectorAll || !document.getElementsByTagName) return;

      function hasClass(el, c) {
        return (' ' + el.className + ' ').indexOf(' ' + c + ' ') > -1;
      }
      function addClass(el, c) {
        if (!hasClass(el, c)) el.className += (el.className ? ' ' : '') + c;
      }
      function removeClass(el, c) {
        el.className = (' ' + el.className + ' ')
          .replace(' ' + c + ' ', ' ')
          .replace(/^\s+|\s+$/g, '');
      }
      function ready(fn) {
        if (document.readyState === 'complete' || document.readyState === 'interactive') fn();
        else if (document.addEventListener) document.addEventListener('DOMContentLoaded', fn, false);
        else fn();
      }

      ready(function () {
        var i;

        // Header Install (iOS only): the newest version whose known minimum OS
        // this device meets. Rows render oldest-first unless data-order=desc;
        // legacy devices arrive pre-filtered newest-first (redirect above).
        var hero = document.querySelector('.hero-install');
        var vroot = document.getElementById('versions');
        var iosMajor = parseInt(document.documentElement.getAttribute('data-ios'), 10);
        // iOS ≤ 3 can't install over the air: the header offers the .ipa.
        var noOta = iosMajor > 0 && iosMajor < 4;
        if (noOta) {
          var alts = document.querySelectorAll('a.navbtn-alt[data-ipa-href]');
          for (i = 0; i < alts.length; i++) alts[i].href = alts[i].getAttribute('data-ipa-href');
        }
        // "4_2_1" / "4.3" → comparable [4, 2, 1].
        function osParts(str) {
          var p = String(str).split(/[._]/), out = [];
          for (var q = 0; q < 3; q++) out.push(parseInt(p[q], 10) || 0);
          return out;
        }
        function osLE(a, b) {
          for (var q = 0; q < 3; q++) if (a[q] !== b[q]) return a[q] < b[q];
          return true;
        }
        var uaOs = navigator.userAgent.match(/OS (\d+(?:_\d+)*)/);
        var isIpad = /iPad/.test(navigator.userAgent);
        if (hero && vroot && iosMajor > 0 && uaOs) {
          var devOs = osParts(uaOs[1]);
          var vrows = vroot.querySelectorAll('.version'), picks = [], vr, vmin, vbtn, vfull;
          for (i = 0; i < vrows.length; i++) {
            vr = vrows[i];
            vmin = parseInt(vr.getAttribute('data-minos'), 10);
            vfull = vr.getAttribute('data-minos-full');
            vbtn = vr.querySelector(noOta ? '.v-lockup a.navbtn-alt' : '.v-lockup a.navbtn-install');
            if (!vbtn || hasClass(vr, 'v-hidden-default') || !(vmin > 0)) continue;
            if (!osLE(osParts(vfull || vmin), devOs)) continue;
            if (!isIpad && vr.getAttribute('data-ipad-only')) continue;
            picks.push([vr, vbtn, vfull || String(vmin)]);
          }
          if (picks.length) {
            var pick = vroot.getAttribute('data-order') === 'desc' ? picks[0] : picks[picks.length - 1];
            var vlabel = pick[0].querySelector('.v-title strong');
            var heroBtn = hero.getElementsByTagName('a')[0];
            heroBtn.href = pick[1].href;
            if (noOta) heroBtn.innerHTML = 'Download';
            hero.querySelector('.hero-ver').appendChild(document.createTextNode(
              (vlabel ? (vlabel.textContent || vlabel.innerText) + ' \u00b7 ' : '') + 'iOS ' + pick[2] + ' or later'));
            addClass(hero, 'is-ready');
          }
        }

        // Phones: the iOS 6 App Store order — icon beside the title and Install,
        // screenshots before the description, side-rail extras at the end.
        // Moves existing nodes (no duplicate markup); desktop is untouched.
        if ((window.innerWidth || document.documentElement.clientWidth) < 768) {
          var titleEl = document.getElementById('title');
          var artEl = document.querySelector('#left-stack .lockup div.artwork');
          if (titleEl && artEl) {
            var artWrap = document.createElement('div');
            artWrap.className = 'lockup application title-art';
            artWrap.appendChild(artEl);
            titleEl.insertBefore(artWrap, titleEl.firstChild);
            addClass(titleEl, 'has-art');
            // No ratings box on phones (the rating history section covers it).
            var ratingsBox = document.querySelector('#left-stack .customer-ratings');
            if (ratingsBox) ratingsBox.parentNode.removeChild(ratingsBox);
          }
          var shotsEl = document.querySelector('.center-stack .screenshots');
          var descEl = document.querySelector('.center-stack .app-description');
          if (shotsEl && descEl) descEl.parentNode.insertBefore(shotsEl, descEl);
          var centerEl = document.querySelector('.center-stack');
          var lockEl = document.querySelector('#left-stack .lockup');
          var filterEl = document.querySelector('.center-stack .filter-bar');
          if (lockEl && filterEl) {
            var info = document.createElement('div');
            info.className = 'phone-info';
            info.innerHTML = '<h4>Information</h4>';
            while (lockEl.firstChild) info.appendChild(lockEl.firstChild);
            lockEl.parentNode.removeChild(lockEl);
            filterEl.parentNode.insertBefore(info, filterEl);
          }
          var railExtras = document.querySelectorAll('#left-stack .in-collections, #left-stack .report-box');
          for (i = 0; centerEl && i < railExtras.length; i++) centerEl.appendChild(railExtras[i]);
        }

        var versionsRoot = document.querySelector('.versions');
        var copyRows = document.querySelectorAll('.version[data-copies]');
        function setAllExpanded(on) {
          for (var k = 0; k < copyRows.length; k++) {
            if (on) addClass(copyRows[k], 'expanded'); else removeClass(copyRows[k], 'expanded');
          }
        }
        if (versionsRoot && hasClass(versionsRoot, 'show-everything')) setAllExpanded(true);

        var everythingToggles = document.querySelectorAll('a.js-everything-toggle');
        for (i = 0; i < everythingToggles.length; i++) {
          (function (link) {
            link.onclick = function (e) {
              if (!versionsRoot) return true;
              if (hasClass(versionsRoot, 'show-everything')) {
                removeClass(versionsRoot, 'show-everything');
                setAllExpanded(false);
                link.innerHTML = link.getAttribute('data-expand');
              } else {
                addClass(versionsRoot, 'show-everything');
                setAllExpanded(true);
                link.innerHTML = link.getAttribute('data-collapse');
              }
              if (e && e.preventDefault) e.preventDefault();
              return false;
            };
          })(everythingToggles[i]);
        }

        if (versionsRoot) {
          addClass(versionsRoot, 'js-copies');
          versionsRoot.onclick = function (e) {
            var t = e.target || e.srcElement;
            while (t && t !== versionsRoot) {
              if (t.tagName === 'A' || t.tagName === 'BUTTON') return true;
              if (hasClass(t, 'v-copies')) return true;
              if (t.getAttribute && t.getAttribute('data-copies') && hasClass(t, 'version')) {
                if (hasClass(t, 'expanded')) removeClass(t, 'expanded'); else addClass(t, 'expanded');
                if (e && e.preventDefault) e.preventDefault();
                return false;
              }
              t = t.parentNode;
            }
            return true;
          };
        }

        var iosSelect = document.querySelector('select.js-ios-select');
        var versionEls = document.querySelectorAll('.version');

        function applyIos(major) {
          var j, el, mm, toHide = [], shown = 0;
          for (j = 0; j < versionEls.length; j++) {
            el = versionEls[j];
            mm = parseInt(el.getAttribute('data-minos'), 10);
            if (major != null && mm > 0 && mm > major) toHide.push(el);
            else { removeClass(el, 'v-hidden-os'); shown++; }
          }
          for (j = 0; j < toHide.length; j++) {
            if (shown === 0) removeClass(toHide[j], 'v-hidden-os');
            else addClass(toHide[j], 'v-hidden-os');
          }
        }

        if (iosSelect) {
          iosSelect.onchange = function () {
            applyIos(iosSelect.value ? parseInt(iosSelect.value, 10) : null);
          };
        }

        // Collapse a long description to 5 lines with "More ▾". Only when the
        // full text runs more than ~1 line past the clamp, so "More" never
        // reveals a single line.
        var desc = document.querySelector('.app-description');
        if (desc) {
          addClass(desc, 'is-clamped');
          if (desc.scrollHeight <= desc.clientHeight + 24) {
            removeClass(desc, 'is-clamped');
          } else {
            // Snap the clip to the last whole line: paragraph gaps aren't a
            // whole line tall, so the plain 5-line max-height cut mid-line.
            var limit = desc.clientHeight, paras = desc.getElementsByTagName('p'), cut = 0;
            var lh = parseFloat(window.getComputedStyle(desc, null).lineHeight) || 19.5;
            for (var pi = 0; pi < paras.length; pi++) {
              var top = paras[pi].offsetTop, bottom = top + paras[pi].offsetHeight;
              if (top >= limit) break;
              cut = bottom <= limit ? bottom : top + Math.floor((limit - top) / lh) * lh;
            }
            if (cut > 0) desc.style.maxHeight = cut + 'px';
            var more = document.createElement('a');
            more.href = '#';
            more.className = 'desc-more';
            more.innerHTML = 'More<span class="tri"></span>';
            more.onclick = function () {
              removeClass(desc, 'is-clamped');
              desc.style.maxHeight = '';
              more.parentNode.removeChild(more);
              return false;
            };
            desc.parentNode.insertBefore(more, desc.nextSibling);
          }
        }

        // Desktop Download popover: close once a build is picked (light
        // dismiss already handles outside clicks and Escape).
        var dlList = document.getElementById('dl-list');
        if (dlList && dlList.hidePopover) {
          dlList.addEventListener('click', function (e) {
            if (e.target.closest('a')) dlList.hidePopover();
          });
        }

        var shotsPicker = document.querySelector('select.js-shots-picker');
        if (shotsPicker) {
          var shotSets = document.querySelectorAll('.shot-set');
          shotsPicker.disabled = false;
          shotsPicker.onchange = function () {
            var sel = shotsPicker.value;
            for (var s = 0; s < shotSets.length; s++) {
              if (shotSets[s].getAttribute('data-shot-set') === sel) {
                var imgs = shotSets[s].getElementsByTagName('img');
                for (var k = 0; k < imgs.length; k++) {
                  var ds = imgs[k].getAttribute('data-src');
                  if (ds) { imgs[k].setAttribute('src', ds); imgs[k].removeAttribute('data-src'); }
                }
                addClass(shotSets[s], 'is-active');
              } else removeClass(shotSets[s], 'is-active');
            }
          };
        }
      });
    })();
  </script>
</Layout>
