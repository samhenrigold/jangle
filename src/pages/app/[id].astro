                            <a class={`wsfbtn navbtn-alt${row.isUniversal ? ' nav-universal' : ''}`} href={c.ipaUrl} data-ipa-href={c.ipaRedirect} download>Download</a>
                          </span>
                        </span>
                      )}
                    </div>
                  ))}
                </div>
              )}
