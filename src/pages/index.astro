---
import { supabaseFor } from '../lib/supabase';
import Layout from '../components/Layout.astro';
import DbError from '../components/DbError.astro';
import AppList from '../components/AppList.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { cached } from '../lib/cache';
import { setCacheHeaders, setDegraded } from '../lib/http';
import { appIconSrc, iconShaOf, appSlug } from '../lib/icons';
import { formatDate } from '../lib/format';
import {
  getChartTypes,
  getSnapshotIndex,
  getSnapshotPositions,
  getArtworkFates,
  chartRowIcon,
  dedupeByDate,
  nearestSnapshot,
  deviceOf,
  formatPrice,
  type ArtworkFate,
} from '../lib/timemachine';
import { getIconsNearDate } from '../lib/appicons';
import { fetchCollectionsWithMembers, fetchIosCollections } from '../lib/collections';
import { IOS_LANDING_MAJORS } from '../lib/sitemap';
import { encodeOsPicks } from '../lib/apps';

setCacheHeaders(Astro.response, 3600);

const supabase = supabaseFor(Astro);
let dbError = false;

let featuredApps: any[] | undefined;
let iconShas: Map<number, string> | undefined;
let osPicks: Map<number, string> | undefined;
let heroSnapshot: any = null;
let heroType: any = null;
let heroEntries: any[] = [];
let heroIconShas: Map<number, string> | undefined;
let heroArtFates: Map<string, ArtworkFate> | undefined;
let heroYearsAgo = 0;

// Featured: the 'featured' editorial collection (collections table) — the
// hand-picked list that used to live in src/lib/featured.ts. The only chain
// allowed to set dbError; the per-iOS install picks chain onto it.
const loadFeatured = async () => {
  const { data: featured, error } = await cached<any[]>('featured_apps_v4', 10 * 60 * 1000, async () => {
    const { data, error } = await supabase
      .from('collections')
      .select('collection_members(position, apps!collection_members_app_id_fkey(id, app_store_id, bundle_id, app_store_name, display_name, version_count, rep_icon_sha256, oldest_icon_sha256, excluded, icon_url:live_icon_url, developers!apps_developer_id_fkey(artist_name)))')
      .eq('slug', 'featured')
      .maybeSingle();
    if (error) return { data: null, error };
    // An unpublished/missing 'featured' collection is an empty section, not
    // an outage.
    const apps = (data?.collection_members || [])
      .sort((x: any, y: any) => x.position - y.position)
      .map((m: any) => m.apps)
      .filter((a: any) => a && !a.excluded)
      .map((a: any) => ({ ...a, developer_artist_name: a.developers?.artist_name }));
    return { data: apps, error: null };
  });
  if (error) {
    featuredApps = [];
    dbError = true;
    return;
  }
  featuredApps = featured || [];
  // Representative (longest-worn) icons ride the embed, oldest as fallback —
  // no second query.
  iconShas = new Map(
    featuredApps
      .filter((a: any) => iconShaOf(a))
      .map((a: any) => [Number(a.id), iconShaOf(a)!] as [number, string])
  );
  // Install buttons: each app's build for every iOS 2–10 (app_ios_install);
  // the page is edge-cached, so the visitor's own pick happens client-side.
  const ids = featuredApps.map((a: any) => Number(a.id));
  if (ids.length) {
    const { data: picks } = await cached<any[]>(`featured_os_picks:${ids.join(',')}`, 10 * 60 * 1000, async () =>
      supabase.from('app_ios_install').select('app_id, os_major, ipa_file_id, version_string').in('app_id', ids));
    osPicks = encodeOsPicks(picks || []);
  }
};

// "This week, years ago" module (plan 010 charts): deterministic per calendar
// week so the page stays edge-cacheable — the week number picks Top Free vs
// Top Paid, and the capture nearest to this month/day 15 years back is shown.
// Decorative: a failure leaves the Featured list standing, never 503s.
const loadHero = async () => {
  const [chartTypes, snapshotIndex] = await Promise.all([
    getChartTypes(supabase),
    getSnapshotIndex(supabase),
  ]);
  if (!chartTypes || !snapshotIndex || !snapshotIndex.length) return;
  const now = new Date();
  const week = Math.floor((now.getTime() - Date.UTC(now.getUTCFullYear(), 0, 1)) / (7 * 86400000));
  const slug = week % 2 ? 'top-paid' : 'top-free';
  heroType = chartTypes.find((t: any) => t.slug === slug) || chartTypes[0];
  heroYearsAgo = 15;
  const target = `${now.getUTCFullYear() - heroYearsAgo}-${String(now.getUTCMonth() + 1).padStart(2, '0')}-${String(now.getUTCDate()).padStart(2, '0')}`;
  const candidates = dedupeByDate(
    snapshotIndex.filter(
      (s) => s.chart_type_id === Number(heroType?.id) && s.genre_id === null && deviceOf(s.source_url) === 'iphone'
    )
  );
  heroSnapshot = nearestSnapshot(candidates, target);
  if (heroSnapshot) {
    const positions = await getSnapshotPositions(supabase, heroSnapshot.id);
    // null = enrichment query failed; drop the hero, keep the page.
    if (positions) {
      heroEntries = positions.slice(0, 5);
      // Icons dated nearest the snapshot, not each app's oldest (decorative —
      // an empty map just leaves the oldest-icon fallback in place). Fates tell
      // us which feed artworks are dead so we don't render a blank over them.
      const ids = heroEntries.map((p: any) => Number(p.apps?.id)).filter(Boolean);
      const [shas, fates] = await Promise.all([
        ids.length ? getIconsNearDate(supabase, ids, heroSnapshot.snapshot_date) : Promise.resolve(undefined),
        getArtworkFates(supabase, heroEntries.map((p: any) => p.artwork_url).filter(Boolean)),
      ]);
      heroIconShas = shas;
      heroArtFates = fates;
    } else heroSnapshot = null;
  }
};

// Collections shelf: one Apple Design Awards year and one iPhone ad campaign,
// re-picked each UTC day (only collections with more than three members in
// the archive), then the editorial picks flagged featured_rank that belong to
// no series (Superlatives). Decorative — a failure drops the module, never 503s.
type HomeCollection = { slug: string; title: string; icons: string[] };
let homeCollections: HomeCollection[] = [];
const DAILY_SERIES = ['Apple Design Award Winners', 'iPhone Commercials'];
const loadCollections = async () => {
  const { data: all } = await fetchCollectionsWithMembers(supabase);
  if (!all) return;
  const day = Math.floor(Date.now() / 86400000);
  const archived = (c: any) => c.collection_members.filter((m: any) => Number(m.apps.version_count) > 0);
  const picks: any[] = DAILY_SERIES.map((series, salt) => {
    const pool = all.filter((c: any) => c.series === series && archived(c).length > 3);
    // ponytail: Knuth multiplicative hash of the day — stable all day, no state.
    return pool.length ? pool[(Math.imul(day + salt * 7919, 2654435761) >>> 0) % pool.length] : null;
  });
  const flagged = all.filter((c: any) => c.featured_rank != null && !c.series)
    .sort((x: any, y: any) => x.featured_rank - y.featured_rank);
  homeCollections = [...picks, ...flagged].filter(Boolean).map((c: any) => ({
    slug: c.slug,
    title: c.title,
    icons: archived(c).map((m: any) => appIconSrc(iconShaOf(m.apps), m.apps.icon_url)).filter(Boolean).slice(0, 4),
  }));
};

// "Apps for your iPod (iOS N)": one card per iOS version, all shipped hidden
// (the page is edge-cached for everyone); the script reveals the visitor's.
let iosCards: { major: number; count: number; icons: string[] }[] = [];
const loadIosCards = async () => { iosCards = (await fetchIosCollections(supabase, IOS_LANDING_MAJORS)).filter((r) => r.count); };

await Promise.all([loadFeatured(), loadHero(), loadCollections(), loadIosCards()]);

const heroDateLabel = heroSnapshot ? formatDate(heroSnapshot.snapshot_date) : '';
const heroHref = heroSnapshot && heroType
  ? `/charts?${heroType.slug !== 'top-free' ? `type=${heroType.slug}&` : ''}date=${heroSnapshot.snapshot_date}`
  : '/charts';

// Always the newest DMG (the Amore API redirects to the latest release).
const LT_DOWNLOAD = 'https://api.amore.computer/v1/apps/gold.samhenri.LightTouchMac/download';

// A transient DB failure must not render as a cacheable empty page.
if (dbError) setDegraded(Astro.response);
---

<Layout title="Legacy Store — Archive of Classic iPhone & iPad Apps" activeTab="featured" description="Browse and install archived versions of classic iPhone and iPad apps, directly on your old iOS device.">
  <div class="content">
    {/* Light Touch announcement. The page is edge-cached for everyone, so it
        ships hidden and the script below reveals it on Mac desktop browsers
        (iPadOS also says "Macintosh" — touch points tell them apart) until
        dismissed. */}
    <div id="lt-banner" class="lt-banner" style="display:none">
      <button type="button" class="lt-close" aria-label="Dismiss">&times;</button>
      <img class="lt-icon" src="/lighttouch/icon.png" srcset="/lighttouch/icon@2x.png 2x" width="57" height="57" alt="" />
      <a class="lt-download" href={LT_DOWNLOAD}><img src="/lighttouch/download.png" srcset="/lighttouch/download@2x.png 2x" width="144" height="38" alt="Download" /></a>
      <div class="lt-body">
        <h3 class="lt-headline">Run classic iOS apps on your Mac.</h3>
        <p class="lt-sub">Light Touch is a new iPod touch emulator,<br /> with Legacy Store built in. <a class="lt-more" href="https://github.com/samhenrigold/LightTouchMac">Learn more</a></p>
      </div>
    </div>
    <script is:inline>
      (function () {
        try {
          var b = document.getElementById('lt-banner');
          if (!/Macintosh/.test(navigator.userAgent) || navigator.maxTouchPoints > 1) return;
          if (window.localStorage && localStorage.getItem('lt-banner-dismissed')) return;
          b.style.display = '';
          b.getElementsByTagName('button')[0].onclick = function () {
            b.style.display = 'none';
            try { localStorage.setItem('lt-banner-dismissed', '1'); } catch (e) {}
          };
        } catch (e) {}
      })();
    </script>

    {dbError ? (
      <DbError />
    ) : (
      <>
        {(homeCollections.length > 0 || iosCards.length > 0) && (
          <>
            <SectionHeader title="Collections" class="sh-top">
              <a href="/collections">See all</a>
            </SectionHeader>
            {/* A row of cards; narrow screens swipe it sideways. inline-block +
                overflow-x is the old-WebKit-safe way to get a card carousel. */}
            <div class="colx-scroll">
              {/* Icons carry data-src: only the revealed card's load. */}
              {iosCards.map((c) => (
                <a class="colx-card colx-ios" data-ios-major={String(c.major)} href={`/collections/ios-${c.major}`} style="display:none">
                  <span class="colx-icons">
                    {c.icons.map((sha) => (
                      <span class="colx-icon"><img data-src={`/icon/${sha}`} alt="" width="40" height="40" /><span class="icon-mask"></span></span>
                    ))}
                  </span>
                  <span class="colx-title">Apps for your <span class="colx-device">iPhone</span> (iOS {c.major})</span>
                </a>
              ))}
              {/* Everyone else (desktop, iOS 11+) leads with iOS 6, the era's
                  peak; the script swaps it for the visitor's own card on old iOS. */}
              {iosCards.filter((c) => c.major === 6).map((c) => (
                <a class="colx-card colx-ios6" href="/collections/ios-6">
                  <span class="colx-icons">
                    {c.icons.map((sha) => (
                      <span class="colx-icon"><img src={`/icon/${sha}`} alt="" width="40" height="40" loading="lazy" /><span class="icon-mask"></span></span>
                    ))}
                  </span>
                  <span class="colx-title">Apps for iOS 6</span>
                </a>
              ))}
              {homeCollections.map((c) => (
                <a class="colx-card" href={`/collections/${c.slug}`}>
                  <span class="colx-icons">
                    {c.icons.map((src) => (
                      <span class="colx-icon"><img src={src} alt="" width="40" height="40" loading="lazy" /><span class="icon-mask"></span></span>
                    ))}
                  </span>
                  <span class="colx-title">{c.title}</span>
                </a>
              ))}
            </div>
            <script is:inline>
              (function () {
                try {
                  var n = document.documentElement.getAttribute('data-ios');
                  if (!n) return;
                  var cards = document.querySelectorAll('.colx-ios');
                  for (var i = 0; i < cards.length; i++) {
                    var c = cards[i];
                    if (c.getAttribute('data-ios-major') !== n) continue;
                    var dev = (navigator.userAgent.match(/iPad|iPod|iPhone/) || ['iPhone'])[0];
                    c.querySelector('.colx-device').innerHTML = dev;
                    var imgs = c.getElementsByTagName('img');
                    for (var j = 0; j < imgs.length; j++) imgs[j].src = imgs[j].getAttribute('data-src');
                    c.style.display = '';
                    var six = document.querySelector('.colx-ios6');
                    if (six) six.style.display = 'none';
                  }
                } catch (e) {}
              })();
            </script>
          </>
        )}

        {heroSnapshot && heroEntries.length > 0 && (
          <>
            <SectionHeader title={`${heroYearsAgo} Years Ago This Week`} />
            <div class="hero-card">
              <div class="hero-head">
                <span class="hero-chart">{heroType.name}</span> as of {heroDateLabel}
              </div>
              <ul class="hero-list">
                {heroEntries.map((p: any) => {
                  // Chart-date artwork first (period-correct), unless it's a
                  // known-dead phobos URL — then the archive's own icon nearest
                  // the snapshot date, then its oldest extracted icon; the app's
                  // LIVE listing icon (modern, era-wrong) only as a last resort.
                  const icon = chartRowIcon(
                    p.artwork_url,
                    p.artwork_url ? heroArtFates?.get(p.artwork_url) : undefined,
                    heroIconShas?.get(Number(p.apps?.id)) || iconShaOf(p.apps),
                    p.apps?.icon_url);
                  const price = formatPrice(p.price_amount, p.price_currency);
                  const href = p.apps ? `/app/${p.apps.app_store_id || p.apps.id}` : null;
                  const inner = (
                    <>
                      <span class="hero-rank">{p.position}</span>
                      <span class="hero-icon">{icon ? <><img src={icon} alt="" width="29" height="29" loading="lazy" /><span class="icon-mask"></span></> : null}</span>
                      <span class="hero-price">{price}</span>
                      <span class="hero-name">{p.display_name}</span>
                    </>
                  );
                  return (
                    <li class="hero-row" data-app-store-id={p.app_store_id || undefined} data-bundle-id={p.apps?.bundle_id || undefined}>
                      {href
                        ? <a class="hero-row-link" href={href}>{inner}</a>
                        : <span class="hero-row-link hero-row-dead">{inner}</span>}
                    </li>
                  );
                })}
              </ul>
              <a class="hero-cta" href={heroHref}>See the full chart</a>
            </div>
          </>
        )}

        <SectionHeader title="Featured" />
        <AppList list={featuredApps} osPicks={osPicks} iconShas={iconShas} />
      </>
    )}
  </div>

  <style>
    /* Light Touch banner — Apple's 2009 iTunes callout ("callout shadow" on
       /itunes/what-is/: white fading down, 0 1px 2px shadow), a touch
       brighter. The button is a pre-rendered Myriad image replicating the
       iTunes 9 "Free download" promo button, as Apple shipped it. Sources: public/lighttouch/*.png. */
    .lt-banner {
      position: relative;
      margin: 0 0 16px 0;
      padding: 14px 36px 14px 16px;
      border: 1px solid #e4e4e4;
      border-radius: 5px;
      background: #f8f8f8;
      background-image: -webkit-linear-gradient(top, #fff 0%, #f8f8f8 100%);
      background-image: linear-gradient(to bottom, #fff 0%, #f8f8f8 100%);
      -webkit-box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
      overflow: hidden;
    }

    /* Headline + two-line subline (~54px) centre on the 57px icon. */
    .lt-icon {
      float: left;
      margin: 0 14px 0 0;
      -webkit-filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
      filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
    }

    /* Button body is image rows 1-34. */
    .lt-download {
      float: right;
      margin: 11px 0 0 12px;
    }

    .lt-download img {
      display: block;
    }

    .lt-download:active img {
      opacity: 0.85;
    }

    .lt-body {
      overflow: hidden;
      padding-top: 1px;
    }

    .lt-headline {
      margin: 0;
      font-size: 17px;
      line-height: 20px;
      font-weight: bold;
      letter-spacing: -0.01em;
      color: #252525;
    }

    .lt-sub {
      margin: 3px 0 0 0;
      font-size: 12px;
      line-height: 16px;
      color: #555;
    }

    /* Apple's a.more: link text plus its 4x7 #08c triangle (morearrow_08c.gif,
       redrawn antialiased at 2x so it's smooth on Retina). */
    .lt-more {
      white-space: nowrap;
      padding-right: 10px;
      background: url(/lighttouch/morearrow@2x.png) no-repeat 100% 50%;
      -webkit-background-size: 4px 7px;
      background-size: 4px 7px;
    }

    .lt-close {
      position: absolute;
      top: 6px;
      right: 8px;
      padding: 0 4px;
      border: 0;
      background: none;
      color: #b5bfc6;
      font-size: 18px;
      line-height: 18px;
      cursor: pointer;
    }

    .lt-close:hover {
      color: #474747;
    }

    /* Featured collections — a card row that swipes sideways when narrow */
    .colx-scroll {
      margin: 0 0 6px 0;
      font-size: 0; /* no whitespace gaps between the inline-block cards */
      white-space: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
    }

    .colx-card {
      display: inline-block;
      vertical-align: top;
      /* 4 × 23% + 3 × 2.666% = 100% */
      width: 23%;
      min-width: 200px;
      margin-right: 2.666%;
      font-size: 12px;
      padding: 12px 10px;
      background: #F3F9FD;
      border-radius: 4px;
      white-space: normal;
      -webkit-box-sizing: border-box;
      box-sizing: border-box;
    }

    .colx-card:last-child {
      margin-right: 0;
    }

    a.colx-card:hover {
      text-decoration: none;
      background-color: #eaf3f8;
    }

    .colx-icons {
      display: block;
      height: 40px;
      margin-bottom: 8px;
      overflow: hidden;
    }

    .colx-icon {
      position: relative;
      float: left;
      width: 40px;
      height: 40px;
      margin-right: 5px;
      background: transparent url('/icon-placeholder.png') no-repeat;
      background-size: 100% 100%;
    }

    .colx-icon img {
      display: block;
      width: 40px;
      height: 40px;
    }

    /* Blue-panel surface: use Apple's blue-cornered gloss mask */
    .colx-icon .icon-mask {
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('/wsf/images/mask100blue.png');
      background-size: 100% 100%;
    }

    .colx-title {
      display: block;
      font-size: 13px;
      font-weight: bold;
      line-height: 17px;
      color: #298cda;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* "This week, years ago" hero — a blue swoosh panel in the era idiom */
    .hero-card {
      background: #F3F9FD;
      border-radius: 4px;
      padding: 0 16px 8px 16px;
      overflow: hidden;
    }

    .hero-head {
      padding: 12px 0 6px 0;
      color: #898989;
      font-size: 11px;
      line-height: 16px;
      border-bottom: 1px solid #e3edf5;
    }

    .hero-chart {
      font-weight: bold;
      color: #474747;
      font-size: 13px;
    }

    .hero-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .hero-row {
      border-bottom: 1px solid #e3edf5;
    }

    .hero-row-link {
      display: block;
      padding: 6px 2px;
      overflow: hidden;
    }

    a.hero-row-link:hover {
      text-decoration: none;
      background-color: #eaf3f8;
    }

    /* Shrink-to-fit, so "1"–"10" hug the row's left edge. */
    .hero-rank {
      float: left;
      min-width: 8px;
      margin-right: 8px;
      line-height: 29px;
      text-align: right;
      font-size: 11px;
      font-weight: bold;
      color: #898989;
    }

    .hero-icon {
      position: relative;
      float: left;
      width: 29px;
      height: 29px;
      margin-right: 8px;
      background: transparent url('/icon-placeholder.png') no-repeat;
      background-size: 100% 100%;
    }

    .hero-icon img {
      display: block;
      width: 29px;
      height: 29px;
    }

    /* Blue-panel surface: use Apple's blue-cornered gloss mask */
    .hero-icon .icon-mask {
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('/wsf/images/mask100blue.png');
      background-size: 100% 100%;
    }

    .hero-price {
      float: right;
      margin-left: 8px;
      line-height: 29px;
      color: #898989;
      font-size: 11px;
      font-weight: bold;
    }

    .hero-name {
      display: block;
      overflow: hidden;
      line-height: 29px;
      font-size: 12px;
      font-weight: bold;
      color: #298cda;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* A chart entry we couldn't match to an archived app isn't a link — don't
       paint its title link-blue, or it reads as clickable. */
    .hero-row-dead .hero-name {
      color: #898989;
    }

    .hero-cta {
      display: block;
      padding: 8px 2px;
      border-top: 1px solid #e3edf5;
      color: #298cda;
      font-size: 12px;
      font-weight: bold;
    }

    .hero-cta:after {
      content: "";
      display: inline-block;
      width: 4px;
      height: 7px;
      margin-left: 6px;
      background: url('/wsf/images/more.gif') 0 0 no-repeat;
    }
  </style>
</Layout>
