---
import Layout from '../components/Layout.astro';
import { setCacheHeaders } from '../lib/http';
Astro.response.status = 404;
// Without this the 404 body is cf-cache-status: BYPASS, so every crawler probe
// of a bad /app/<id> re-runs resolveApp (2 DB hits). The not-found page is
// static — let the edge hold it. setCacheHeaders keeps status 404 intact.
setCacheHeaders(Astro.response, 3600);
---
<Layout title="Not Found — Legacy Store" activeTab="none" description="Page not found on Legacy Store.">
  <div class="content">
    <div class="notfound">
      <h1>Not Found</h1>
      <p>This app or page isn't in the archive.</p>
      <p>Try searching above, or head back to <a href="/">Featured</a>, <a href="/categories">Categories</a>, or the <a href="/most-archived">Top 25</a>.</p>
    </div>
  </div>

  <style>
    .notfound {
      text-align: center;
      padding: 40px 20px;
      color: #767676;
    }

    .notfound h1 {
      color: #474747;
      font-size: 22px;
      margin: 0 0 12px 0;
    }

    .notfound a {
      color: #298cda;
      font-weight: bold;
    }
  </style>
</Layout>
