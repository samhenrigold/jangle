---
import { supabaseFor } from '../../lib/supabase';
import Layout from '../../components/Layout.astro';
import DbError from '../../components/DbError.astro';
import Pagination from '../../components/Pagination.astro';
import AppList from '../../components/AppList.astro';
import { clampPage } from '../../lib/search';
import { APP_LIST_COLS, flattenAppRow } from '../../lib/apps';
import { cached } from '../../lib/cache';
import { setCacheHeaders, setDegraded } from '../../lib/http';
import { getAppIcons } from '../../lib/appicons';
import { devicesEndingOn } from '../../lib/emulator';
import { IOS_LANDING_MAJORS } from '../../lib/sitemap';

// "Apps for iOS N" landing pages — what owners of old devices search for.
// Backed by app_ios_install (derived daily by refresh_app_ios_install()): per
// app, the newest archived copy that runs on N's final release on the devices
// stuck there (CPU, capabilities, not quarantined, still on archive.org). So
// every row has a working Install/Download and shows that build's own icon.
// Ranked by how many versions the archive holds. Capped at iOS 10: past that
// 32-bit apps stop running.
const MAJORS = IOS_LANDING_MAJORS;

const major = Number(Astro.params.major);
if (!MAJORS.includes(major)) return Astro.rewrite('/404');

setCacheHeaders(Astro.response, 86400); // archive data changes at ingest; deploys purge (purge-html.yml)

const PAGE_SIZE = 50;
const page = clampPage(new URL(Astro.request.url).searchParams.get('page'));
const supabase = supabaseFor(Astro);

const { data, error } = await cached<{ rows: any[]; total: number }>(`ios-inst2:${major}:${page}`, 10 * 60 * 1000, async () => {
  const { data: picks, error, count } = await supabase
    .from('app_ios_install')
    .select('app_id, ipa_file_id, version_string, icon_sha256', { count: 'exact' })
    .eq('os_major', major)
    .order('version_count', { ascending: false })
    .order('app_id', { ascending: true })
    .range((page - 1) * PAGE_SIZE, page * PAGE_SIZE - 1);
  if (error || !picks?.length) return { data: { rows: [], total: count || 0 }, error };
  const { data: apps, error: appErr } = await supabase
    .from('apps').select(APP_LIST_COLS).in('id', picks.map((p: any) => p.app_id));
  const byId = new Map((apps || []).map((a: any) => [Number(a.id), flattenAppRow(a)]));
  const rows = picks
    .map((p: any) => {
      const a = byId.get(Number(p.app_id));
      return a && { ...a, install: { ipaFileId: p.ipa_file_id, version: p.version_string, iconSha: p.icon_sha256 } };
    })
    .filter(Boolean);
  return { data: { rows, total: count || 0 }, error: appErr };
});
const apps = data?.rows || [];
const totalPages = Math.max(1, Math.ceil((data?.total || 0) / PAGE_SIZE));
// The icon of the build you'd get; the app's representative icon only when
// that build has no loose bundle icon (Assets.car era).
const noIcon = apps.filter((a: any) => !a.install.iconSha).map((a: any) => Number(a.id));
const iconShas = new Map(noIcon.length ? await getAppIcons(supabase, noIcon) : []); // copy: the helper's map is cached
for (const a of apps) if (a.install.iconSha) iconShas.set(Number(a.id), a.install.iconSha);
if (error) setDegraded(Astro.response);
const origin = new URL(Astro.request.url).origin;
const installs = new Map(apps.map((a: any) => [Number(a.id), {
  href: `itms-services://?action=download-manifest&url=${encodeURIComponent(`${origin}/manifest/${a.install.ipaFileId}.plist`)}`,
  dlHref: `/ipa/${a.install.ipaFileId}`,
  version: a.install.version,
}]));

const devices = devicesEndingOn(major);
const fmt = (n: number) => n.toLocaleString('en-US');
---

<Layout
  title={`Apps for iOS ${major} — ${fmt(data?.total || 0)} Old iPhone & iPad Apps — Legacy Store`}
  activeTab="collections"
  canonicalPath={`/collections/ios-${major}${page > 1 ? `?page=${page}` : ''}`}
  description={`${fmt(data?.total || 0)} archived iPhone and iPad apps with a version that installs on iOS ${major}${devices.length ? `, for devices like the ${devices.slice(0, 3).map((d) => d.name).join(', ')}` : ''}.`}
>
  <div class="content">
    {error ? (
      <DbError />
    ) : (
      <>
        <h1 class="ios-title">Apps for iOS {major}</h1>
        <p class="ios-nav">
          {MAJORS.map((m) => (m === major ? <strong>iOS {m}</strong> : <a href={`/collections/ios-${m}`}>iOS {m}</a>))}
        </p>
        <AppList list={apps} iconShas={iconShas} installs={installs} />
        {totalPages > 1 && <Pagination page={page} totalPages={totalPages} hrefFor={(p) => `/collections/ios-${major}?page=${p}`} nextLabel={`Next ${PAGE_SIZE}`} />}
      </>
    )}
  </div>
</Layout>

<style>
  .ios-title { margin: 0 0 12px; font-size: 1.6em; line-height: 1.2; color: #474747; }
  /* Pill switcher; one swipeable row on phones. */
  .ios-nav { margin: 0 0 14px; font-size: 12px; white-space: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .ios-nav a, .ios-nav strong {
    display: inline-block; margin: 0 4px 4px 0; padding: 3px 10px;
    border: 1px solid #c9d6e0; border-radius: 12px; -webkit-border-radius: 12px; line-height: 16px;
  }
  .ios-nav a:hover { text-decoration: none; background: #eaf3f8; }
  .ios-nav strong { color: #fff; border-color: #2c76e0; background: #3a87ec; }
</style>
