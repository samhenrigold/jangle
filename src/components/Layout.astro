---
import '../styles/global.css';
import { SITE_ORIGIN } from '../lib/http';

const {
  title = 'Legacy Store',
  activeTab = 'featured',
  description = 'Legacy Store — install archived versions of classic iPhone and iPad apps directly on old iOS devices.',
  searchQuery = '',
  // Canonical URL path. Pages reachable under several URLs (an app has
  // app_store_id, internal-id, and bundle-id aliases plus filter params) set
  // it explicitly; paginated pages include their ?page= (canonicalizing page
  // 2+ to page 1 would hide deep apps from discovery). Everywhere else the
  // self-referential default keeps all canonicalization signals agreeing.
  canonicalPath = Astro.url.pathname,
  // Optional schema.org JSON-LD (object or array of objects) rendered in the
  // head. Only mark up data visible on the page.
  jsonLd = null,
  // Extra class on <body> for page-specific chrome (e.g. 'charts-landing').
  bodyClass = '',
  // Open Graph card for link sharing: { title?, description?, path, image?,
  // type? }. Omit on pages that don't need a rich unfurl.
  og = null,
} = Astro.props;

// The productheader row carries the real site navigation — the slot the
// original page used for its apple.com/itunes links.
const NAV = [
  { key: 'featured', label: 'Featured', href: '/' },
  { key: 'charts', label: 'Charts', href: '/charts' },
  { key: 'categories', label: 'Categories', href: '/categories' },
  { key: 'collections', label: 'Collections', href: '/collections' },
  { key: 'search', label: 'Search', href: '/search' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonicalPath && <link rel="canonical" href={SITE_ORIGIN + canonicalPath} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {og && (
      <>
        <meta property="og:site_name" content="Legacy Store" />
        <meta property="og:type" content={og.type || 'website'} />
        <meta property="og:title" content={og.title || title} />
        <meta property="og:description" content={og.description || description} />
        {og.path && <meta property="og:url" content={SITE_ORIGIN + og.path} />}
        {og.image && <meta property="og:image" content={og.image} />}
        <meta name="twitter:card" content="summary" />
      </>
    )}
    <title>{title}</title>
    <!-- Tag <html> with the device type before paint, so device-specific CSS
         (e.g. Install vs Download on app pages) applies without a flash. Pages
         render identically for every device and edge-cache; this class is the
         only per-device branch, done on the client. Old-WebKit-safe. -->
    <script is:inline>
      (function () {
        try {
          var ua = navigator.userAgent, d = document.documentElement;
          if (/iPhone|iPad|iPod/.test(ua)) {
            d.className += (d.className ? ' ' : '') + 'is-ios';
            var m = ua.match(/OS (\d+)_/);
            if (m) d.setAttribute('data-ios', m[1]);
          } else {
            d.className += (d.className ? ' ' : '') + 'is-desktop';
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={bodyClass ? `software ${bodyClass}` : 'software'}>
    <div id="productheader">
      <h2><a class="wordmark" href="/"><img src="/wsf/images/legacystore.png" srcset="/wsf/images/legacystore@2x.png 2x" width="171" height="32" alt="Legacy Store" /></a></h2>
      <form class="ph-search" action="/search" method="get">
        <span class="search-wrapper">
          <span class="left"></span>
          <input type="search" name="q" value={searchQuery} placeholder="Search" aria-label="Search Legacy Store" />
          <span class="right"></span>
        </span>
      </form>
      <ul>
        {NAV.map((n) => (
          <li><a href={n.href} class={activeTab === n.key ? 'active' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Phone-only search strip (the sprite nav above is hidden < 768px) -->
    <form id="phonesearch" action="/search" method="get">
      <span class="search-wrapper">
        <span class="left"></span>
        <input type="search" name="q" value={searchQuery} placeholder="Search" aria-label="Search Legacy Store" />
        <span class="right"></span>
      </span>
    </form>

    <div id="main">
      <div id="content">
        <div class="cap top"></div>
        <div class="padder">
          <slot />
        </div>
        <div class="cap bottom"></div>
      </div>
    </div>

    <!-- Press "/" anywhere to jump to the search box (unless you're already
         typing in a field). A keyboard nicety for desktop; touch devices never
         reach it. Old-WebKit-safe (var, keyCode fallback, no ES6). -->
    <script is:inline>
      (function () {
        try {
          document.addEventListener('keydown', function (e) {
            var isSlash = e.key === '/' || (!e.key && e.keyCode === 191 && !e.shiftKey);
            if (!isSlash || e.metaKey || e.ctrlKey || e.altKey) return;
            var t = e.target || {};
            var tag = (t.tagName || '').toLowerCase();
            if (tag === 'input' || tag === 'textarea' || tag === 'select' || t.isContentEditable) return;
            var inputs = document.querySelectorAll('input[type="search"][name="q"]');
            for (var i = 0; i < inputs.length; i++) {
              // Focus the one that's actually visible at this width (desktop
              // header vs the phone strip); offsetParent is null when hidden.
              if (inputs[i].offsetParent !== null) {
                e.preventDefault();
                inputs[i].focus();
                try { inputs[i].select(); } catch (err) {}
                return;
              }
            }
          });
        } catch (e) {}
      })();
    </script>

    <!-- Search autocomplete: debounced fetch of /api/suggest under whichever
         header search box is in use. Progressive enhancement — no fetch (old
         WebKit) means the plain GET form works exactly as before. -->
    <script is:inline>
      (function () {
        try {
          if (typeof window.fetch !== 'function' || !document.querySelectorAll) return;
          var timer = null;
          var open = null; // the currently-shown list, if any
          function close() {
            if (open && open.parentNode) open.parentNode.removeChild(open);
            open = null;
          }
          function show(input, items) {
            close();
            if (!items.length) return;
            var ul = document.createElement('ul');
            ul.className = 'search-suggest';
            ul.setAttribute('role', 'listbox');
            for (var i = 0; i < items.length; i++) {
              var it = items[i];
              var li = document.createElement('li');
              var a = document.createElement('a');
              a.href = it.href;
              if (it.icon) {
                var img = document.createElement('img');
                img.src = it.icon;
                img.alt = '';
                img.width = 24; img.height = 24;
                a.appendChild(img);
              }
              var name = document.createElement('span');
              name.className = 'ss-name';
              name.textContent = it.name;
              a.appendChild(name);
              if (it.dev) {
                var dev = document.createElement('span');
                dev.className = 'ss-dev';
                dev.textContent = it.dev;
                a.appendChild(dev);
              }
              if (it.type && it.type !== 'app') {
                var tag = document.createElement('span');
                tag.className = 'ss-type';
                tag.textContent = it.type;
                a.appendChild(tag);
              }
              li.appendChild(a);
              ul.appendChild(li);
            }
            // Fixed-position on <body>, anchored to the input's viewport rect.
            // The header is overflow:hidden (float clearfix), so anything
            // absolutely positioned inside it gets clipped — fixed on body
            // escapes every ancestor's clipping and stacking context.
            var rect = input.getBoundingClientRect();
            ul.style.left = rect.left + 'px';
            ul.style.top = (rect.bottom + 2) + 'px';
            ul.style.width = Math.max(rect.width, 220) + 'px';
            document.body.appendChild(ul);
            open = ul;
          }
          function onInput(e) {
            var input = e.target;
            var q = input.value.replace(/^\s+|\s+$/g, '');
            if (timer) clearTimeout(timer);
            if (q.length < 2) { close(); return; }
            timer = setTimeout(function () {
              fetch('/api/suggest?q=' + encodeURIComponent(q))
                .then(function (r) { return r.json(); })
                .then(function (body) {
                  // Stale response guard: only render if the box still says q.
                  if (input.value.replace(/^\s+|\s+$/g, '') === q) show(input, body.suggestions || []);
                })
                .catch(function () {});
            }, 200);
          }
          var inputs = document.querySelectorAll('input[type="search"][name="q"]');
          for (var i = 0; i < inputs.length; i++) {
            inputs[i].setAttribute('aria-expanded', 'false');
            inputs[i].addEventListener('input', onInput);
          }
          // Click-away / Escape close. mousedown fires before the click's blur,
          // so suggestion links still navigate.
          document.addEventListener('mousedown', function (e) {
            if (open && !open.contains(e.target)) close();
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' || e.keyCode === 27) close();
          });
          // Fixed positioning doesn't track the page — just close on scroll.
          window.addEventListener('scroll', close, true);
        } catch (e) {}
      })();
    </script>
    <style is:global>
      /* Autocomplete dropdown (built by the script above, so is:global —
         Astro's scoped attributes never land on JS-created nodes). */
      .search-suggest {
        /* Appended to <body>; left/top/width set inline from the input's
           viewport rect (fixed = immune to the header's overflow:hidden). */
        position: fixed;
        z-index: 1000;
        margin: 2px 0 0;
        padding: 4px 0;
        list-style: none;
        background: #fff;
        border: 1px solid #b3b3b3;
        border-radius: 5px;
        -webkit-border-radius: 5px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.25);
        -webkit-box-shadow: 0 3px 10px rgba(0,0,0,0.25);
        text-align: left;
      }
      .search-suggest li { margin: 0; padding: 0; }
      .search-suggest a {
        display: block;
        overflow: hidden;
        padding: 4px 8px;
        font-size: 12px;
        color: #333;
        text-decoration: none;
        white-space: nowrap;
        text-overflow: ellipsis;
      }
      .search-suggest a:hover { background: #298cda; color: #fff; }
      .search-suggest a:hover .ss-dev { color: #d8eafd; }
      .search-suggest img {
        vertical-align: middle;
        margin-right: 6px;
        border-radius: 4px;
        -webkit-border-radius: 4px;
      }
      .search-suggest .ss-name { font-weight: bold; }
      .search-suggest .ss-dev { margin-left: 6px; font-size: 11px; color: #898989; }
      .search-suggest .ss-type {
        float: right;
        margin-left: 8px;
        font-size: 10px;
        color: #898989;
        text-transform: capitalize;
        border: 1px solid #d0d0d0;
        border-radius: 3px;
        -webkit-border-radius: 3px;
        padding: 0 4px;
        line-height: 15px;
      }
      .search-suggest a:hover .ss-type { color: #d8eafd; border-color: #7db8e8; }
    </style>

    <div id="globalfooter">
      <p class="gf-buy">A metadata-only preservation archive by <a href="https://samhenri.gold/">Sam&nbsp;Henri&nbsp;Gold</a>. App binaries are hosted by the <a href="https://archive.org/" rel="noopener">Internet&nbsp;Archive</a>, not here.</p>
      <ul class="gf-links piped">
        <li><a href="/contribute" class="first">Contribute</a></li>
        <li><a href="/recent">Recent</a></li>
        <li><a href="/colophon">Colophon</a></li>
        <li><a href="/stats">Stats</a></li>
        <li><a href="/api">API</a></li>
        <li><a href="https://github.com/samhenrigold/jangle" rel="noopener">Source</a></li>
      </ul>
    </div>
  </body>
</html>
